# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# 缓存与中间产物
.cache/
.DS_Store
projects/02_modeling/experiments/*/output/

# 编译产物
*.aux
*.log
*.out
*.toc
*.bbl
*.blg

# 历届竞赛资料（仅本地保留）
