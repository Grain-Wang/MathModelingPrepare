{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodelingprepare.local/schemas/gate-receipt.schema.json",
  "title": "M1 gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate",
    "status",
    "inputs",
    "checks",
    "independent_review",
    "findings",
    "rework_suggestions"
  ],
  "properties": {
    "gate": {"const": "M1"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "independent_review": {"$ref": "#/$defs/independentReview"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "rework_suggestions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes"],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "problem_statement",
            "attachment",
            "official_rule",
            "model_contract",
            "analysis_report",
            "terminology_table"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "result"],
      "properties": {
        "level": {"type": "string", "enum": ["L0", "L1", "L2", "L3"]},
        "tool": {"type": "string"},
        "exit_code": {"type": "integer"},
        "result": {"type": "string", "minLength": 1}
      }
    },
    "independentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewers", "consensus"],
      "properties": {
        "reviewers": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/reviewer"}},
        "consensus": {"type": "string", "enum": ["pass", "fail"]}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "model", "independence_attested", "findings"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "independence_attested": {"type": "boolean"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "claim", "evidence", "suggestion"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["P0", "P1", "P2"]},
        "claim": {"type": "string", "minLength": 1},
        "evidence": {"type": "string"},
        "suggestion": {"type": "string", "minLength": 1}
      }
    }
  }
}
